@@ -3958,7 +3976,17 @@
     u8 palSlot;
     u8 spriteId;
     struct SpriteSheet sheet = {sStorage->tileBuffer, MON_PIC_SIZE, GFXTAG_DISPLAY_MON};
+#ifdef HOST_BUILD
+    // PC port: displayMonPalette is only set once the cursor is on a Pokemon,
+    // but this loads it when the PC opens, so it can still be uninitialized
+    // heap memory. On the GBA that reads 32 junk bytes (the bus ignores the
+    // top address bits) into a slot that is overwritten before the sprite is
+    // shown; on the host the junk pointer crashes. Load a blank palette then.
+    static const u16 sBlankPalette[16] = {0};
+    struct SpritePalette palette = {sStorage->displayMonPalette != NULL ? sStorage->displayMonPalette : sBlankPalette, PALTAG_DISPLAY_MON};
+#else
     struct SpritePalette palette = {sStorage->displayMonPalette, PALTAG_DISPLAY_MON};
+#endif
