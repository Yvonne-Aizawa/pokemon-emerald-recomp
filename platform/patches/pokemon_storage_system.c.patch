@@ -1965,6 +1965,14 @@
     DoScheduledBgTilemapCopiesToVram();
     ScrollBackground();
     UpdateCloseBoxButtonFlash();
+#ifdef HOST_BUILD
+    // PC port: leaving the PC frees sStorage in RunTasks above, but the
+    // sprites' callbacks (e.g. SpriteCB_CursorShadow) still run this frame and
+    // read through it. Upstream already guards its own uses (see
