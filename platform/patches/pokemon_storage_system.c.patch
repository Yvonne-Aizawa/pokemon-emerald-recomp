@@ -5126,6 +5154,14 @@
 
 static void SetMovingMonPriority(u8 priority)
 {
+#ifdef HOST_BUILD
+    // PC port: called whenever the cursor reaches the buttons, the party or
+    // the box, also when no Pokemon is held and movingMonSprite is NULL. On
+    // the GBA that writes to the BIOS area, which ignores it; on the host it
+    // crashes.
+    if (sStorage->movingMonSprite == NULL)
+        return;
+#endif
     sStorage->movingMonSprite->oam.priority = priority;
 }
 
