@@ -1997,6 +2010,11 @@
 {
     ResetTasks();
     sStorage = Alloc(sizeof(*sStorage));
+#ifdef HOST_BUILD
+    // PC port: see CreateDisplayMonSprite.
+    if (sStorage != NULL)
+        sStorage->displayMonPalette = NULL;
+#endif
     if (sStorage == NULL)
     {
