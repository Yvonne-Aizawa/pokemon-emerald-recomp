--- a/src/malloc.c
+++ b/src/malloc.c
@@ -1,9 +1,35 @@
+#if PKM_ASAN
+#include <sanitizer/asan_interface.h>
+#endif
+
 #include "global.h"
 #include "malloc.h"
+
+// PC port: with AddressSanitizer (PLAN.md, Phase 19a), unused heap memory --
+// free blocks, and what an allocation doesn't use -- is marked off-limits,
+// so reads and writes into it are reported; the heap is one big array to
+// ASan otherwise. Block headers stay accessible to the allocator.
+// PKM_ASAN_HEAP=0 in the environment turns it off.
+// (ASan's functions, not its ASAN_POISON_MEMORY_REGION macros: those are
+// no-ops unless the preprocessor sees -fsanitize=address, and the game's
+// sources are preprocessed without it.)
+#if PKM_ASAN
+bool32 Host_AsanHeapChecks(void);  // platform/src/host_gba_misc.c
+#define HEAP_POISON(addr, size)   do { if (Host_AsanHeapChecks()) __asan_poison_memory_region(addr, size); } while (0)
+#define HEAP_UNPOISON(addr, size) __asan_unpoison_memory_region(addr, size)
+#else
+#define HEAP_POISON(addr, size)
+#define HEAP_UNPOISON(addr, size)
+#endif
+
 #if TESTING
 #include "test/test.h"
 #endif
 
+#ifdef HOST_BUILD
+void Dma3_DetachRequestsFrom(const void *start, u32 size);  // dma3_manager.c.patch
+#endif
+
 static void *sHeapStart;
 static u32 sHeapSize;
 
@@ -66,6 +92,7 @@
                     pos->allocated = TRUE;
                     pos->size = size;
 
+                    HEAP_UNPOISON(splitBlock, sizeof(struct MemBlock));
                     PutMemBlockHeader(splitBlock, pos, pos->next, foundBlockSize);
 
                     pos->next = splitBlock;
@@ -77,6 +104,7 @@
                 pos->locationHi = ((uintptr_t)location) >> 14;
                 pos->locationLo = (uintptr_t)location;
 
+                HEAP_UNPOISON(pos->data, size);
                 return pos->data;
             }
         }
@@ -96,6 +124,12 @@
         struct MemBlock *block = (struct MemBlock *)((u8 *)pointer - sizeof(struct MemBlock));
         AGB_ASSERT(block->magic == MALLOC_SYSTEM_ID);
         AGB_ASSERT(block->allocated == TRUE);
+
+#ifdef HOST_BUILD
+        // PC port: copies still queued from this block keep its bytes
+        // (dma3_manager.c.patch).
+        Dma3_DetachRequestsFrom(pointer, block->size);
+#endif
         block->allocated = FALSE;
 
         // If the freed block isn't the last one, merge with the next block
@@ -127,8 +161,11 @@
 
                 block->magic = 0;
                 block->prev->size += sizeof(struct MemBlock) + block->size;
+                block = block->prev;
             }
         }
+
+        HEAP_POISON(block->data, block->size);
     }
 }
 
