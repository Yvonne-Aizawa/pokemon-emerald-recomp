 // GF cast Task data to ListMenu in many places, which effectively puts
 // an upper bound on sizeof(struct ListMenu).
+#if defined(HOST_BUILD) && __SIZEOF_POINTER__ > 4
+// PC port: 64-bit pointers make ListMenu larger than the task data buffer.
+// Keep one properly aligned instance per task; initialization fills every field.
+static struct ListMenu sHostListMenus[NUM_TASKS];
+#define LIST_MENU_DATA(taskId) (&sHostListMenus[taskId])
+#else
 STATIC_ASSERT(sizeof(struct ListMenu) <= sizeof(((struct Task *)NULL)->data), ListMenuTooLargeForTaskData);
+#define LIST_MENU_DATA(taskId) ((struct ListMenu *)gTasks[taskId].data)
+#endif

 // Cursors after this point are created using a sprite with their own task.
 // This allows them to have idle animations. Cursors prior to this are simply printed text.
@@ -48,6 +56,18 @@
     u16 tileTag;
     u16 palTag;
 };
+
+// PC port: pointer-bearing cursor structs need native storage: task data
+// is only two-byte aligned and the outline cursor also exceeds 32 bytes.
+#if defined(HOST_BUILD) && __SIZEOF_POINTER__ > 4
+static struct ScrollIndicatorPair sHostScrollPairs[NUM_TASKS];
+static struct RedOutlineCursor sHostOutlineCursors[NUM_TASKS];
+#define SCROLL_PAIR_DATA(id) (&sHostScrollPairs[id])
+#define OUTLINE_CURSOR_DATA(id) (&sHostOutlineCursors[id])
+#else
+#define SCROLL_PAIR_DATA(id) ((struct ScrollIndicatorPair *)gTasks[id].data)
+#define OUTLINE_CURSOR_DATA(id) ((struct RedOutlineCursor *)gTasks[id].data)
+#endif

