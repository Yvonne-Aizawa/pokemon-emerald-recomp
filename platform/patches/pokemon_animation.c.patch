--- a/src/pokemon_animation.c
+++ b/src/pokemon_animation.c
@@ -527,7 +527,14 @@
         // Task_HandleMonAnimation handles more than just KO animations,
         // but if the counter is non-zero then only KO animations are running.
         // This assumption is not checked.
+#ifdef HOST_BUILD
+        // PC port: outside battle gBattleStruct is NULL. On the GBA this reads
+        // the BIOS area and any write is ignored, so nothing happens; on the
+        // host it would crash. (Hit by Professor Birch's Lotad.)
+        if (gBattleStruct != NULL && gBattleStruct->battlerKOAnimsRunning > 0)
+#else
         if (gBattleStruct->battlerKOAnimsRunning > 0)
+#endif
             gBattleStruct->battlerKOAnimsRunning--;
         DestroyTask(taskId);
     }
@@ -1239,7 +1246,14 @@
     u8 var6 = sVerticalShakeData[sprite->data[5]][1];
     u8 amplitude = 0;
 
+#ifdef HOST_BUILD
+    // PC port: the end-of-table row {-1, 0} gets here with var6 == 0. The
+    // GBA's software division doesn't trap and the result is unused (the
+    // animation ends below); x86 raises SIGFPE.
+    if (var5 != (u8)-2 && var6 != 0)
+#else
     if (var5 != (u8)-2)
+#endif
         amplitude = (var6 - var7) * var5 / var6;
     else
         amplitude = 0;
@@ -3670,7 +3684,12 @@
 
     var6 = sVerticalShakeData[sprite->data[5]][1];
     var7 = 0;
+#ifdef HOST_BUILD
+    // PC port: as in VerticalShakeTwice, var6 is 0 on the end-of-table row.
+    if (sVerticalShakeData[sprite->data[5]][0] != (u8)-2 && var6 != 0)
+#else
     if (sVerticalShakeData[sprite->data[5]][0] != (u8)-2)
+#endif
         var7 = (var6 - var9) * var5 / var6;
     else
         var7 = 0;
