+// (the bits are never used). On the GBA that reads the next ROM bytes; on PC
+// the next global. Not a bug, but AddressSanitizer reports it, so these
+// functions aren't checked.
+#define HOST_NO_ASAN __attribute__((no_sanitize_address))
+
+// PC port: copying machine code into a buffer and jumping into it isn't
