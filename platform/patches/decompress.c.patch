 u32 LoadCompressedSpriteSheet(const struct CompressedSpriteSheet *src)
 {
+#ifdef HOST_BUILD
+    // PC port: some sheets declare more than their graphics decompress to
+    // (the wall clock's hands: 0x2000), and the whole declared size is
+    // loaded, which read past the buffer (found with PKM_ASAN_HEAP). The
+    // buffer now has the declared size; the rest is zero (transparent).
+    u32 decompressedSize = GetDecompressedDataSize(src->data);
+    void *buffer = AllocZeroed(max(decompressedSize, src->size));
+    if (buffer != NULL)
+        DecompressDataWithHeaderWram(src->data, buffer);
+#else
     void *buffer = malloc_and_decompress(src->data, NULL);
+#endif
     u32 ret = DoLoadCompressedSpriteSheet(src, buffer);
     Free(buffer);

