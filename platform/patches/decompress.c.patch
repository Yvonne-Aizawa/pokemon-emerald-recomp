 extern void FastUnsafeCopy32(void *, const void *, u32 size);
 
+#ifdef HOST_BUILD
+// PC port: copying machine code into a buffer and jumping into it isn't
+// possible (or needed) on the host. Leave the buffers unused and call the
+// function that would have been copied directly.
+#undef FUNC_BUFFER_SIZE
+#define FUNC_BUFFER_SIZE(funcStart, funcEnd) 1
+#define CopyFuncToIwram(funcBuffer, funcStartAddress, funcEndAdress) ((void)(funcBuffer))
+#define IWRAM_FUNC(funcBuffer, func) ((void *)(func))
+#else
 //  Dark Egg magic
 static inline void CopyFuncToIwram(void *funcBuffer, const void *funcStartAddress, const void *funcEndAdress)
 {
     FastUnsafeCopy32(funcBuffer, funcStartAddress, funcEndAdress - funcStartAddress);
 }
+#define IWRAM_FUNC(funcBuffer, func) ((void *)(funcBuffer))
+#endif
 
