@@ -3046,6 +3052,13 @@
 
 static void PlayAnimation(enum BattlerId battler, u8 animId, const u16 *argPtr, const u8 *nextInstr)
 {
+    // PC port: many scripts pass NULL for animations that take no argument
+    // (playanimation BS_ATTACKER, B_ANIM_ZMOVE_ACTIVATE, NULL); the GBA reads
+    // BIOS memory there and the animation ignores the value.
+    const u16 nullArg = 0;
