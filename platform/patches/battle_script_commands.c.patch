+
     if (B_TERRAIN_BG_CHANGE == FALSE && animId == B_ANIM_RESTORE_BG)
     {
         // workaround for .if not working
@@ -8156,7 +8169,14 @@
 
 static u32 ComputeBallShakeOdds(u32 odds)
 {
+#ifdef HOST_BUILD
+    // PC port: odds is 0 when the ball can't catch at all (e.g. a Heavy Ball
+    // on a light Pokémon). The GBA's division (libgcc's __aeabi_uidiv) gives
+    // 0xFFFFFFFF for that instead of trapping.
+    odds = Sqrt(Sqrt(odds != 0 ? 16711680 / odds : 0xFFFFFFFF));
+#else
     odds = Sqrt(Sqrt(16711680 / odds));
+#endif
     odds = 1048560 / odds;
     return odds;
 }
