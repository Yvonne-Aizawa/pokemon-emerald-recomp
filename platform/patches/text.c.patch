+#ifdef HOST_BUILD
+// PC port: shifting a 32-bit value by 32 or more gives 0 on ARM, but x86
+// only uses the low 5 bits of the count (so `x >> 32` is `x`). The glyph
+// code below relies on the ARM result.
+static inline u32 ArmLsl(u32 value, u32 shift) { return shift >= 32 ? 0 : value << shift; }
+static inline u32 ArmLsr(u32 value, u32 shift) { return shift >= 32 ? 0 : value >> shift; }
+#else
+#define ArmLsl(value, shift) ((value) << (shift))
+#define ArmLsr(value, shift) ((value) >> (shift))
+#endif
