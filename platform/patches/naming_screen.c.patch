--- a/src/naming_screen.c
+++ b/src/naming_screen.c
@@ -1022,6 +1022,14 @@
 
 static void SpriteCB_Cursor(struct Sprite *sprite)
 {
+#ifdef HOST_BUILD
+    // PC port: after naming a caught Pokemon, MainState_Exit frees
+    // sNamingScreen and returns straight to BattleMainCB2, which keeps
+    // animating this screen's sprites. Upstream then reads through NULL
+    // (harmless on the GBA, the screen is black); here that is a crash.
+    if (sNamingScreen == NULL)
+        return;
+#endif
     if (sprite->animEnded)
         StartSpriteAnim(sprite, 0);
 
@@ -1086,6 +1094,11 @@
     const s16 y[] = {2, 3, 2, 1};
     u8 pos;
 
+#ifdef HOST_BUILD
+    // PC port: see SpriteCB_Cursor.
+    if (sNamingScreen == NULL)
+        return;
+#endif
     pos = GetTextEntryPosition();
     if (pos != (u8)sprite->sId)
     {
@@ -2071,6 +2084,13 @@
 static void CB2_NamingScreen(void)
 {
     RunTasks();
+#ifdef HOST_BUILD
+    // PC port: Task_NamingScreen's exit state frees sNamingScreen. On the GBA the
+    // sprite callbacks that still run this frame read through the NULL pointer
+    // harmlessly; on the host that is a crash.
+    if (sNamingScreen == NULL)
+        return;
+#endif
     AnimateSprites();
     BuildOamBuffer();
     UpdatePaletteFade();
@@ -2092,6 +2112,11 @@
     LoadOam();
     ProcessSpriteCopyRequests();
     TransferPlttBuffer();
+#ifdef HOST_BUILD
+    // PC port: the VBlank callback outlives sNamingScreen for a frame (see above).
+    if (sNamingScreen == NULL)
+        return;
+#endif
     SetGpuReg(REG_OFFSET_BG1VOFS, sNamingScreen->bg1vOffset);
     SetGpuReg(REG_OFFSET_BG2VOFS, sNamingScreen->bg2vOffset);
     SetGpuReg(REG_OFFSET_BG1CNT, GetGpuReg(REG_OFFSET_BG1CNT) & 0xFFFC);
