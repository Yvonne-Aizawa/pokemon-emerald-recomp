@@ -1,4 +1,15 @@
 #include "global.h"
+
+#ifdef HOST_BUILD
+// PC port: some script command and special function pointers are tagged by
+// adding ROM_SIZE, which on the GBA still points at the same code (the
+// cartridge ROM is mirrored at 0x0A000000). The host has no mirror, so
+// strip the tag before calling. Code always lies in 0x08000000-0x09FFFFFF
+// (checked at startup in platform/src/host_gba_misc.c).
+#define CALLABLE(func) ((__typeof__(func))((uintptr_t)(func) & ~(uintptr_t)0x2000000))
+#else
+#define CALLABLE(func) (func)
+#endif
 #include "script.h"
 #include "event_data.h"
 #include "field_screen_effect.h"
