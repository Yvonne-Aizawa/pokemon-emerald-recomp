 void AgbMainLoop(void)
 {
     for (;;)
     {
+        AgbMainLoopIteration();
+        WaitForVBlank();
+    }
+}
+
+#ifdef HOST_BUILD
+// PC port: the interrupts the GBA raises while WaitForVBlank waits -- V-count
+// (line 150), then V-blank (line 160) -- dispatched through gIntrTable as
+// IntrMain does on hardware. H-blank interrupts are raised by the renderer
+// (platform/src/host_render.c); serial ones are not emulated.
+void HostMain_RaiseVBlankInterrupts(void)
+{
+    if (REG_IME && (REG_IE & INTR_FLAG_VCOUNT) && gIntrTable[0])
+        gIntrTable[0]();
+    if (REG_IME && (REG_IE & INTR_FLAG_VBLANK) && gIntrTable[4])
+        gIntrTable[4]();
+}
+
+// PC port: one frame of AgbMainLoop, then its V-blank interrupts.
+void HostMain_RunFrame(void)
+{
+    AgbMainLoopIteration();
+    HostMain_RaiseVBlankInterrupts();
+}
+#endif
