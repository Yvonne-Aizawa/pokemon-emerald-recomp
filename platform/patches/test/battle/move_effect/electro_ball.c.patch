+SINGLE_BATTLE_TEST("Electro Ball handles a target whose modified Speed rounds down to zero", s16 damage)
+{
+    enum Item item;
+    u32 status;
+
+    PARAMETRIZE { item = ITEM_NONE; status = STATUS1_NONE; }
+    PARAMETRIZE { item = ITEM_IRON_BALL; status = STATUS1_NONE; }
+    PARAMETRIZE { item = ITEM_NONE; status = STATUS1_PARALYSIS; }
+
+    GIVEN {
+        WITH_CONFIG(B_PARALYSIS_SPEED, GEN_7);
+        ASSUME(GetItemHoldEffect(ITEM_IRON_BALL) == HOLD_EFFECT_IRON_BALL);
+        PLAYER(SPECIES_WOBBUFFET) { Speed(100); SpAttack(100); }
+        OPPONENT(SPECIES_WOBBUFFET) { Speed(1); Item(item); Status1(status); MaxHP(500); HP(500); SpDefense(100); }
+    } WHEN {
+        TURN { MOVE(player, MOVE_ELECTRO_BALL); MOVE(opponent, MOVE_CELEBRATE); }
+    } SCENE {
+        ANIMATION(ANIM_TYPE_MOVE, MOVE_ELECTRO_BALL, player);
+        HP_BAR(opponent, captureDamage: &results[i].damage);
+    } FINALLY {
+        EXPECT_EQ(results[0].damage, results[1].damage);
+        EXPECT_EQ(results[0].damage, results[2].damage);
+    }
+}
