+AI_SINGLE_BATTLE_TEST("AI critical damage handles blocked critical hits and Gen 1 thresholds")
+{
+    u32 generation;
+    enum Species species;
+    enum Ability ability;
+
+    PARAMETRIZE { generation = GEN_9; species = SPECIES_ARMALDO; ability = ABILITY_BATTLE_ARMOR; }
+    PARAMETRIZE { generation = GEN_9; species = SPECIES_KINGLER; ability = ABILITY_SHELL_ARMOR; }
+    PARAMETRIZE { generation = GEN_1; species = SPECIES_WOBBUFFET; ability = ABILITY_SHADOW_TAG; }
+
+    GIVEN {
+        WITH_CONFIG(B_CRIT_CHANCE, generation);
+        AI_FLAGS(AI_FLAG_CHECK_BAD_MOVE | AI_FLAG_CHECK_VIABILITY | AI_FLAG_TRY_TO_FAINT | AI_FLAG_RISKY);
+        PLAYER(species) { Ability(ability); Moves(MOVE_SPLASH); }
+        OPPONENT(SPECIES_WOBBUFFET) { Moves(MOVE_SCRATCH, MOVE_SPLASH); }
+    } WHEN {
+        TURN { MOVE(player, MOVE_SPLASH); EXPECT_MOVE(opponent, MOVE_SCRATCH); }
+    }
+}
