+// PC port: whether STATE_ASSIGN_TEST skips the test (the filter). Replaying
+// the cost assignment after a crash must skip the same tests, or with a
+// filter the processes' costs drift apart and they run some tests twice and
+// others not at all (as on the GBA, with Hydra).
+static bool32 FilteredOut(const struct Test *test)
+{
+    if (gTestRunnerState.filterMode == TEST_FILTER_MODE_FILENAME_EXACT)
+        return !ExactMatch(gTestRunnerArgv, test->filename);
