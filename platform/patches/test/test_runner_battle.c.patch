+// PC port: the ARM helpers below run the test function on DATA.stack. That
+// matters beyond stack size: the function is called again for each phase
+// (GIVEN, WHEN, SCENE, THEN), and its locals must keep their addresses and
+// values between the calls, e.g. `damage` in HP_BAR(..., captureDamage:
+// &damage), written while the battle runs and read in THEN. On the host the
+// game's own calls would overwrite them on the normal stack, so the function
+// runs on a stack of its own (ucontext; at HOST_TEST_RAM, above), cleared
+// with DATA at the start of each test as DATA.stack is. DATA.stack's 1 KiB
+// is too small for host code.
+#include <ucontext.h>
+
+static ucontext_t sHostTestCaller, sHostTestContext;
+static void (*sHostTestThunk)(void);
+
+static void HostTest_ClearStack(void)
+{
+    memset(sHostTestStack, 0, HOST_TEST_STACK_SIZE);
+}
+
+static void HostTest_RunThunk(void)
+{
+    sHostTestThunk();
+}
+
+// Runs thunk on sHostTestStack. A test that fails longjmps out of it to the
+// runner's frame loop; the next call starts the context afresh.
+static void HostTest_CallOnStack(void (*thunk)(void))
+{
+    sHostTestThunk = thunk;
+    getcontext(&sHostTestContext);
+    sHostTestContext.uc_stack.ss_sp = sHostTestStack;
+    sHostTestContext.uc_stack.ss_size = HOST_TEST_STACK_SIZE;
+    sHostTestContext.uc_link = &sHostTestCaller;
+    makecontext(&sHostTestContext, HostTest_RunThunk, 0);
+    swapcontext(&sHostTestCaller, &sHostTestContext);
+}
