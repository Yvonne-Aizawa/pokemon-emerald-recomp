+// PC port: game code passes gMPlay_PokemonCry, which is NULL until the
+// first cry plays. Through NULL the GBA reads BIOS junk, whose "ident" never
+// matches, so these calls do nothing; on the host they would crash.
+#define HOST_IGNORE_NULL_PLAYER(mplayInfo, ret) \
+    if ((mplayInfo) == NULL)                    \
+        return ret;
+// PC port: a song number past the song table (gSongTable has
+// LAST_PHONEME_SONG + 1 entries). Shadow Force's and Phantom Force's
+// animation scripts pass SOUND_PAN_ATTACKER as the sound (0xFFC0): the GBA
+// reads whatever follows the table in ROM, the host reads past its memory.
+// Such a song is ignored.
+#include "constants/songs.h"
+#define HOST_IGNORE_BAD_SONG(n) \
+    if ((n) > LAST_PHONEME_SONG)  \
+        return;
+#else
+#define HOST_IGNORE_NULL_PLAYER(mplayInfo, ret)
+#define HOST_IGNORE_BAD_SONG(n)
+#endif
+
